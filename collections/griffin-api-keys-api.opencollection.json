{
  "opencollection": "1.0.0",
  "info": {
    "name": "The Griffin API keys API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "API keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/api-keys/:api-key-id",
            "params": [
              {
                "name": "api-key-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the API key without `api-key-secret`."
        },
        {
          "info": {
            "name": "Delete API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v0/api-keys/:api-key-id",
            "params": [
              {
                "name": "api-key-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes the API Key. This operation cannot be undone."
        },
        {
          "info": {
            "name": "List API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/organizations/:organization-id/api-keys",
            "params": [
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "A base64 encoded opaque string returned in paginated responses."
              },
              {
                "name": "page[before]",
                "value": "",
                "type": "query",
                "description": "A base64 encoded opaque string returned in paginated responses."
              },
              {
                "name": "organization-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all active API keys in your organization."
        },
        {
          "info": {
            "name": "Create API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v0/organizations/:organization-id/api-keys",
            "params": [
              {
                "name": "organization-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a new API key. This is the only time `api-key-secret` is shown."
        },
        {
          "info": {
            "name": "List API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v0/users/:user-id/api-keys",
            "params": [
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "A base64 encoded opaque string returned in paginated responses."
              },
              {
                "name": "page[before]",
                "value": "",
                "type": "query",
                "description": "A base64 encoded opaque string returned in paginated responses."
              },
              {
                "name": "user-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all your active API keys."
        }
      ]
    }
  ],
  "bundled": true
}