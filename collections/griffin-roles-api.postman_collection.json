{
  "item": [
    {
      "id": "fe64249b-87f3-4d5b-82d2-3af4a921efeb",
      "name": "Roles",
      "description": {
        "content": "A role represents a pre-defined set of capabilities that can be assigned to a [user](#tag/Users) via their [membership](#tag/Memberships) in an [organization](#tag/Organization). By default, the first user in an organization gets assigned an administration role. Subsequent users get assigned the most limited set of capabilities.",
        "type": "text/plain"
      },
