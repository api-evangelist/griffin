              },
              {
                "name": "filter[updated-at][gte]",
                "value": "",
                "type": "query",
                "description": "Return only holds updated at or after the given timestamp."
              },
              {
                "name": "filter[status][in][]",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "",
