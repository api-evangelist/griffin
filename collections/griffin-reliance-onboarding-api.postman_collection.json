      "name": "Reliance onboarding",
      "description": {
        "content": "Reliance onboarding allows you to create and submit an application on behalf of your customer, using information about them you have already collected. For more information, checkout our [onboarding guides](https://docs.griffin.com/docs/tags/onboarding).",
        "type": "text/plain"
      },
